{
  "name": "crew-calendar",
  "version": "0.1.0",
  "displayName": "Calendar",
  "description": "Create events in Crew, agree on a time in chat, or keep a draft for later. Browse your schedule by day, week, month or year. Scheduling suggestions are optional and apply to the conversations you choose. On macOS, view Apple Calendar events and confirm new saves in a native window.",
  "tags": [
    "calendar",
    "productivity",
    "preview"
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/crew-calendar",
        "label": "Calendar",
        "icon": "Calendar",
        "iconUrl": "assets/calendar-spark.svg"
      }
    ],
    "sidebar": {
      "section": "Apps",
      "order": 15
    }
  },
  "permissions": {
    "api": [
      "/api/apps/crew-calendar/settings",
      "/api/apps/crew-calendar/calendar",
      "/api/apps/crew-calendar/calendar/*"
    ],
    "events": [],
    "storage": true,
    "network": false,
    "cron": false
  },
  "backend": {
    "hooks": {
      "routes": "backend.routes:register_routes"
    }
  },
  "mcpServers": {
    "drafts": {
      "command": "python3",
      "args": [
        "-c",
        "import sys,runpy;from kiro_crew.apps.manager import app_dir;d=app_dir(sys.argv[1]);sys.argv=[str(d/'backend'/'mcp_server.py'),str(d/'data')];runpy.run_path(sys.argv[0],run_name='__main__')",
        "crew-calendar"
      ]
    }
  },
  "platform": {
    "os": [
      "macos",
      "windows",
      "linux"
    ],
    "arch": []
  },
  "minKiroCrewVersion": "0.9.0-nightly.20261003t172902",
  "author": "Jihun Kim",
  "iconPath": "ui/assets/store/icon.png",
  "heroImage": "ui/assets/store/hero.jpg",
  "heroImageDetail": "ui/assets/store/hero-detail.jpg",
  "screenshots": [
    "ui/assets/store/screenshot-week.png",
    "ui/assets/store/screenshot-conversation.png",
    "ui/assets/store/screenshot-event.png"
  ]
}
