{
  "name": "crew-calendar",
  "version": "0.1.0",
  "displayName": "Calendar",
  "description": "Create and manage events in Crew Calendar. Discuss suggestions in chat and register after agreeing. Keep drafts only when requested. Apple Calendar saves require native confirmation on macOS.",
  "tags": [
    "calendar",
    "productivity",
    "preview"
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/crew-calendar",
        "label": "Calendar",
        "icon": "Calendar",
        "iconUrl": "assets/calendar-spark.svg"
      }
    ],
    "sidebar": {
      "section": "Apps",
      "order": 15
    }
  },
  "permissions": {
    "api": [
      "/api/apps/crew-calendar/settings",
      "/api/apps/crew-calendar/calendar",
      "/api/apps/crew-calendar/calendar/*"
    ],
    "events": [],
    "storage": true,
    "network": false,
    "cron": false
  },
  "backend": {
    "hooks": {
      "routes": "backend.routes:register_routes"
    }
  },
  "mcpServers": {
    "drafts": {
      "command": "python3",
      "args": [
        "-c",
        "import sys,runpy;from kiro_crew.apps.manager import app_dir;d=app_dir(sys.argv[1]);sys.argv=[str(d/'backend'/'mcp_server.py'),str(d/'data')];runpy.run_path(sys.argv[0],run_name='__main__')",
        "crew-calendar"
      ]
    }
  },
  "platform": {
    "os": [
      "macos",
      "windows",
      "linux"
    ],
    "arch": []
  },
  "minKiroCrewVersion": "0.9.0-nightly.20261003t172902"
}
