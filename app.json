{
  "name": "crew-calendar",
  "version": "0.2.0",
  "displayName": "Calendar",
  "description": "Review conversation-linked drafts using the host operating system timezone. On macOS, optionally connect Apple Calendar and save reviewed events after native confirmation. External calendar connections on other platforms are not yet implemented.",
  "tags": [
    "calendar",
    "productivity",
    "preview"
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/crew-calendar",
        "label": "Calendar",
        "icon": "Calendar",
        "iconUrl": "assets/calendar-spark.svg"
      }
    ],
    "sidebar": {
      "section": "Apps",
      "order": 15
    }
  },
  "permissions": {
    "api": [
      "/api/apps/crew-calendar/drafts",
      "/api/apps/crew-calendar/drafts/*",
      "/api/apps/crew-calendar/settings",
      "/api/apps/crew-calendar/calendar",
      "/api/apps/crew-calendar/calendar/*"
    ],
    "events": [],
    "storage": true,
    "network": false,
    "cron": false
  },
  "backend": {
    "hooks": {
      "routes": "backend.routes:register_routes"
    }
  },
  "mcpServers": {
    "drafts": {
      "command": "python3",
      "args": [
        "-c",
        "import sys,runpy;from kiro_crew.apps.manager import app_dir;d=app_dir(sys.argv[1]);sys.argv=[str(d/'backend'/'mcp_server.py'),str(d/'data')];runpy.run_path(sys.argv[0],run_name='__main__')",
        "crew-calendar"
      ]
    }
  },
  "platform": {
    "os": [
      "macos",
      "windows",
      "linux"
    ],
    "arch": []
  },
  "minKiroCrewVersion": "0.9.0-nightly.20261003t172902"
}
